# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# ---- MongoDB Atlas Database ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.tmx8cbt.mongodb.net/?appName=Cluster0
MONGODB_NAME=flight_portal
USE_MONGODB=1

# ---- Live flight API (kept server-side only; never rendered into HTML/JS) ----
# Provider adapter: aerodatabox | aviationstack
FLIGHT_API_PROVIDER=aerodatabox
FLIGHT_API_KEY=your_api_key_here

# AeroDataBox only: how you subscribed.
#   rapidapi  -> https://aerodatabox.p.rapidapi.com  (X-RapidAPI-Key / X-RapidAPI-Host headers)
#   apimarket -> https://prod.api.market/api/v1/aedbx/aerodatabox
FLIGHT_API_AUTH_STYLE=rapidapi
# Optional override of the provider base URL (Aviationstack free plan is HTTP only)
# FLIGHT_API_BASE_URL=

FLIGHT_API_TIMEOUT=12
# Short cache so repeated clicks/refreshes don't burn a small free quota (seconds)
FLIGHT_API_CACHE_SECONDS=30
# Auto-refresh interval used by the results page (30-60 recommended)
FLIGHT_AUTO_REFRESH_SECONDS=60
SITE_NAME=Airvoyage

